# .env.example
# Полный открытый каталог. .env содержит только реальные ключи и пароли.
APP_BIND=0.0.0.0
APP_PORT=8087
APP_PUBLIC_BASE_URL=http://192.168.55.3:8087
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=spec_mapper
DATABASE_USER=spec_mapper
DATABASE_PASSWORD=
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=spec_mapper
RABBITMQ_VHOST=spec_mapper
RABBITMQ_QUEUE=spec_mapper.jobs
RABBITMQ_PASSWORD=
SHARED_EMBEDDING_BASE_URL=http://shared-embedding:8000/v1
SHARED_EMBEDDING_MODEL=shared-embedding
# При наличии утверждённой revision укажите её здесь; иначе проверяются metadata и probe.
EMBEDDING_REVISION=
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=90
QDRANT_URL=http://qdrant:6333
QDRANT_ALIAS=spec_mapper_catalog
# Уточните Docker DNS upstream на вашем сервере; контейнер должен быть в ai-shared.
EXTRACTING_BASE_URL=http://spec-extracting-ai-api-1:8083
EXTRACTING_API_KEY=
API_KEY=
# Именованные интеграции; реальные ключи bootstrap записывает только в .env.
API_KEYS={}
CATALOG_ADMIN_KEY=
SESSION_SECRET=
COOKIE_SECURE=false
DATA_DIRECTORY=data
# Утверждено владельцем: исключать все позиции с конфликтующим кодом и показывать warning.
DUPLICATE_CODE_POLICY=quarantine
CATALOG_DAILY_SYNC=false
CATALOG_SYNC_SECONDS=86400
RETENTION_SECONDS=3600
DRAFT_TTL_SECONDS=3600
# Административная индексация не использует часовой TTL документов.
CATALOG_IMPORT_TIMEOUT_SECONDS=86400
POLL_SECONDS=3
UPSTREAM_TIMEOUT_SECONDS=900
HTTP_TIMEOUT_SECONDS=30
MAX_RESULT_BYTES=15000000
MAX_XML_BYTES=200000000
MAX_ITEMS=10000
TOP_K=5
MATCH_THRESHOLD=0.88
MATCH_MARGIN=0.05
WORKER_CONCURRENCY=2
LEASE_SECONDS=120
MAX_ATTEMPTS=3
RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=INFO
