# .env.example
# Полный открытый каталог. .env содержит только реальные ключи и пароли.
APP_BIND=0.0.0.0
APP_PORT=8087
APP_PUBLIC_BASE_URL=http://192.168.55.3:8087
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=spec_mapper
DATABASE_USER=spec_mapper
DATABASE_PASSWORD=
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=spec_mapper
RABBITMQ_VHOST=spec_mapper
RABBITMQ_QUEUE=spec_mapper.jobs
RABBITMQ_PASSWORD=
SHARED_EMBEDDING_BASE_URL=http://shared-embedding:8000/v1
SHARED_EMBEDDING_MODEL=shared-embedding
# При наличии утверждённой revision укажите её здесь; иначе проверяются metadata и probe.
EMBEDDING_REVISION=
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=90
QDRANT_URL=http://qdrant:6333
QDRANT_ALIAS=spec_mapper_catalog
# Уточните Docker DNS upstream на вашем сервере; контейнер должен быть в ai-shared.
EXTRACTING_BASE_URL=http://spec-extracting-ai-api-1:8083
EXTRACTING_API_KEY=
API_KEY=
# Именованные интеграции; реальные ключи bootstrap записывает только в .env.
API_KEYS={}
CATALOG_ADMIN_KEY=
SESSION_SECRET=
COOKIE_SECURE=false
DATA_DIRECTORY=data
# Утверждено владельцем: исключать все позиции с конфликтующим кодом и показывать warning.
DUPLICATE_CODE_POLICY=quarantine
CATALOG_DAILY_SYNC=false
# Применяется только при первом bootstrap; затем источник задаётся в PostgreSQL через GUI.
CATALOG_SOURCE_TYPE=local_xml
CATALOG_SYNC_SECONDS=86400
# Bootstrap один раз; после этого расписанием управляет PostgreSQL, старый интервал не используется.
CATALOG_SYNC_TIME_UTC=15:00
CATALOG_AUDIT_RETENTION_DAYS=90
DASHBOARD_METRICS_RETENTION_DAYS=90
CATALOG_STAGING_DIRECTORY=staging
OPERATOR_SESSION_SECONDS=900
OPERATOR_TICKET_SECONDS=120
# Только loopback сервера: доступ к выдаче кода через SSH-туннель, без LAN публикации.
OPERATOR_PORT=8088
OPERATOR_GATEWAY_BASE_URL=http://api:8000
WORKER_HEARTBEAT_TTL_SECONDS=45
# HTTP Basic разрешается только явным ONEC_CATALOG_ALLOW_HTTP=true и адресным allowlist.
ONEC_CATALOG_URL=http://192.168.10.30/erp_update/hs/catalog/export
ONEC_CATALOG_HTTP_METHOD=GET
ONEC_CATALOG_AUTH_TYPE=basic
ONEC_CATALOG_USERNAME=
ONEC_CATALOG_PASSWORD=
ONEC_CATALOG_TOKEN=
ONEC_CATALOG_RESPONSE_FORMAT=json
ONEC_CATALOG_EXPORT_MODE=full
ONEC_CATALOG_TIMEOUT_SECONDS=60
ONEC_CATALOG_COMPLETION_HEADER=X-Catalog-Complete
ONEC_CATALOG_COMPLETION_VALUE=true
ONEC_CATALOG_CONTRACT_CONFIRMED=false
ONEC_CATALOG_ALLOWED_HOSTS=["192.168.10.30"]
ONEC_CATALOG_ALLOWED_NETWORKS=["192.168.10.30/32"]
ONEC_CATALOG_ALLOWED_PORTS=[80,443]
ONEC_CATALOG_ALLOW_HTTP=false
# Лимит каталога независим от MAX_RESULT_BYTES временных документов.
MAX_CATALOG_BYTES=200000000
ONEC_CATALOG_MAX_ROWS=200000
ONEC_CATALOG_MIN_ITEMS=1
ONEC_CATALOG_MAX_SHRINK_RATIO=0.1
# Разовое адресное подтверждение сокращения: проверенный SHA-256; после запуска очистить.
ONEC_CATALOG_SHRINK_ACK_SHA256=
# Отдельный server-only ключ; bootstrap создаёт его атомарно, UI его не выдаёт.
ONEC_CATALOG_WEBHOOK_KEY=
ONEC_WEBHOOK_BATCH_WINDOW_SECONDS=20
ONEC_WEBHOOK_BATCH_SIZE=50
ONEC_WEBHOOK_MAX_EVENTS_PER_BATCH=100
ONEC_WEBHOOK_MAX_BACKLOG=10000
ONEC_WEBHOOK_MAX_BODY_BYTES=32768
ONEC_WEBHOOK_RATE_LIMIT_PER_MINUTE=120
ONEC_WEBHOOK_ALLOWED_NETWORKS=[]
RETENTION_SECONDS=3600
DRAFT_TTL_SECONDS=3600
# Административная индексация не использует часовой TTL документов.
CATALOG_IMPORT_TIMEOUT_SECONDS=86400
POLL_SECONDS=3
UPSTREAM_TIMEOUT_SECONDS=900
HTTP_TIMEOUT_SECONDS=30
MAX_RESULT_BYTES=15000000
MAX_XML_BYTES=200000000
MAX_ITEMS=10000
TOP_K=5
MATCH_THRESHOLD=0.88
MATCH_MARGIN=0.05
WORKER_CONCURRENCY=2
LEASE_SECONDS=120
MAX_ATTEMPTS=3
RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=INFO
