# .gitattributes
# Bash и исходники одинаково читаются в Linux и Windows.
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.ps1 text eol=crlf
# Сохраняем контрольные суммы официальных ресурсов и исходное оформление лицензии.
src/resources/swagger_ui/* text eol=lf
src/resources/swagger_ui/NOTICE.txt -whitespace
